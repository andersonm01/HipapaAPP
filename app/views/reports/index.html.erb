<%# ── External deps (only loaded on this page) ─────────────────────────── %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .rp-bg        { background:#f1f5f9; margin-top:-1.5rem; padding:1.5rem 0 3rem; min-height:100vh; }
  .rp-card      { background:#fff; border-radius:14px; border:1px solid #e2e8f0;
                  box-shadow:0 1px 4px rgba(0,0,0,.06); }
  .rp-card-hd   { padding:.85rem 1.2rem; border-bottom:1px solid #f1f5f9; }
  .rp-card-bd   { padding:1rem 1.2rem; }
  .kpi-icon     { width:34px; height:34px; border-radius:8px; flex-shrink:0;
                  display:flex; align-items:center; justify-content:center; font-size:1rem; }
  .kpi-val      { font-size:1.25rem; font-weight:800; line-height:1.15; color:#0f172a; letter-spacing:-.02em; }
  .kpi-lbl      { font-size:.64rem; font-weight:700; text-transform:uppercase;
                  letter-spacing:.06em; color:#94a3b8; }
  .sec-lbl      { font-size:.7rem; font-weight:700; text-transform:uppercase;
                  letter-spacing:.07em; color:#94a3b8; }
  .period-nav .pn-btn {
    border-radius:20px; font-size:.8rem; font-weight:600; padding:.3rem .85rem;
    border:1px solid #cbd5e1; color:#475569; background:#fff; cursor:pointer;
    transition:background .1s,color .1s; }
  .period-nav .pn-btn:hover:not(.active) { background:#f8fafc; color:#1e293b; }
  .period-nav .pn-btn.active { background:#1e293b; color:#fff; border-color:#1e293b; }
  .insight-item { background:#fff; border-radius:10px; border-left:4px solid;
                  padding:.8rem 1rem; margin-bottom:.6rem;
                  box-shadow:0 1px 3px rgba(0,0,0,.05); font-size:.875rem; }
  .insight-item.success { border-color:#16a34a; }
  .insight-item.danger  { border-color:#dc2626; }
  .insight-item.warning { border-color:#f59e0b; }
  .insight-item.info    { border-color:#3b82f6; }
  .insight-item.primary { border-color:#8b5cf6; }
  .table-sm td, .table-sm th { padding:.45rem .75rem; }
  @media(max-width:575px){ .kpi-val{ font-size:1.1rem; } }

  /* ── Skeletons ────────────────────────────────────────────────────────── */
  .skel { position:relative; overflow:hidden; background:#e2e8f0; border-radius:6px; }
  .skel::after { content:''; position:absolute; inset:0; transform:translateX(-100%);
    background:linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent);
    animation: rp-shimmer 1.3s infinite; }
  @keyframes rp-shimmer { 100% { transform:translateX(100%); } }

  /* ── Filters ──────────────────────────────────────────────────────────── */
  .rp-filters select.form-select-sm { font-size:.8rem; }

  /* ── Heatmap ──────────────────────────────────────────────────────────── */
  .heatmap-scroll { overflow-x:auto; padding-bottom:.25rem; }
  .heatmap-grid   { display:grid; grid-template-columns:64px repeat(24, minmax(26px,1fr));
                    gap:3px; min-width:760px; }
  .heatmap-cell   { aspect-ratio:1; border-radius:4px; }
  .heatmap-hourlbl{ font-size:.62rem; color:#94a3b8; text-align:center; }
  .heatmap-daylbl { font-size:.72rem; color:#475569; font-weight:600; display:flex; align-items:center; }

  /* ── Pagination ───────────────────────────────────────────────────────── */
  .rp-page-btn { border:1px solid #cbd5e1; background:#fff; color:#475569; border-radius:8px;
                 font-size:.8rem; padding:.25rem .65rem; }
  .rp-page-btn:disabled { opacity:.4; }
  .rp-page-btn.active { background:#1e293b; color:#fff; border-color:#1e293b; }
</style>

<div class="rp-bg">
<div class="container-xl px-3">

  <%# ── HEADER ──────────────────────────────────────────────────────────── %>
  <div class="d-flex justify-content-between align-items-start mb-3 pt-2 flex-wrap gap-2">
    <div>
      <div class="sec-lbl">Panel de analítica</div>
      <h1 class="fw-bold mb-0" style="font-size:1.55rem;color:#0f172a;">Reportes</h1>
    </div>
    <div class="d-flex gap-2">
      <a href="#" class="btn btn-sm btn-outline-secondary rp-csv-link" download>
        <i class="bi bi-download me-1"></i>Exportar CSV
      </a>
      <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
        <i class="bi bi-printer me-1"></i>Imprimir
      </button>
    </div>
  </div>

  <%# ── FILTERS ─────────────────────────────────────────────────────────── %>
  <div class="rp-card p-3 mb-2 rp-filters">
    <div class="period-nav d-flex flex-wrap gap-2 mb-3" id="periodNav">
      <button type="button" class="pn-btn" data-period="today">Hoy</button>
      <button type="button" class="pn-btn" data-period="last_7_days">Últimos 7 días</button>
      <button type="button" class="pn-btn active" data-period="month">Este mes</button>
      <button type="button" class="pn-btn" data-period="quarter">Trimestre</button>
      <button type="button" class="pn-btn" data-period="year">Año</button>
      <button type="button" class="pn-btn" data-period="custom">Personalizado</button>
    </div>

    <div id="customRangeRow" class="d-flex flex-wrap align-items-end gap-2 mb-3" style="display:none;">
      <div>
        <label class="form-label fw-semibold small mb-1">Desde</label>
        <input type="date" id="filterFrom" class="form-control form-control-sm">
      </div>
      <div>
        <label class="form-label fw-semibold small mb-1">Hasta</label>
        <input type="date" id="filterTo" class="form-control form-control-sm">
      </div>
      <button type="button" class="btn btn-sm btn-primary" id="customRangeApply">Aplicar</button>
    </div>

    <div class="row g-2">
      <div class="col-6 col-md-3">
        <select id="filterMesero" class="form-select form-select-sm">
          <option value="">Todos los meseros</option>
          <% @meseros.each do |m| %><option value="<%= m %>"><%= m %></option><% end %>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <select id="filterCategoria" class="form-select form-select-sm">
          <option value="">Todas las categorías</option>
          <% @categorias.each do |c| %><option value="<%= c %>"><%= c %></option><% end %>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <select id="filterProducto" class="form-select form-select-sm">
          <option value="">Todos los productos</option>
          <% @productos.each do |nombre, id| %><option value="<%= id %>"><%= nombre %></option><% end %>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <select id="filterTipoServicio" class="form-select form-select-sm">
          <option value="">Todo servicio</option>
          <option value="mesa">En Mesa</option>
          <option value="llevar">Para Llevar</option>
          <option value="domicilio">Domicilio</option>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <select id="filterTipoPago" class="form-select form-select-sm">
          <option value="">Todo medio de pago</option>
          <option value="efectivo">Efectivo</option>
          <option value="transferencia">Transferencia</option>
        </select>
      </div>
    </div>
  </div>

  <p class="text-muted mb-3" id="periodLabel" style="font-size:.82rem;min-height:1.1em;">
    <i class="bi bi-calendar3 me-1"></i>
  </p>

  <%# ── KPI CARDS ──────────────────────────────────────────────────────── %>
  <div class="row g-2 mb-4" id="kpiCards">
    <% 4.times do %>
      <div class="col-6 col-md-3">
        <div class="rp-card d-flex align-items-center gap-2 p-2 h-100">
          <div class="kpi-icon skel"></div>
          <div class="min-w-0 flex-grow-1">
            <div class="skel mb-1" style="height:7px;width:70%;"></div>
            <div class="skel" style="height:16px;width:85%;"></div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── TREND + TOP PRODUCTS ───────────────────────────────────────────── %>
  <div class="row g-3 mb-3">
    <div class="col-lg-8">
      <div class="rp-card h-100">
        <div class="rp-card-hd d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <div class="sec-lbl">Tendencia</div>
            <strong style="color:#1e293b;">Evolución de ventas</strong>
          </div>
          <div class="btn-group btn-group-sm" id="granularityToggle" role="group">
            <button type="button" class="btn btn-outline-secondary active" data-granularity="day">Día</button>
            <button type="button" class="btn btn-outline-secondary" data-granularity="week">Semana</button>
            <button type="button" class="btn btn-outline-secondary" data-granularity="month">Mes</button>
          </div>
        </div>
        <div class="rp-card-bd">
          <div style="height:260px;position:relative;">
            <canvas id="trendChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="rp-card h-100">
        <div class="rp-card-hd">
          <div class="sec-lbl">Ranking</div>
          <strong style="color:#1e293b;">Top productos</strong>
        </div>
        <div class="rp-card-bd">
          <div style="height:260px;position:relative;">
            <canvas id="topProductsChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── HEATMAP ─────────────────────────────────────────────────────────── %>
  <div class="row g-3 mb-3">
    <div class="col-12">
      <div class="rp-card">
        <div class="rp-card-hd">
          <div class="sec-lbl">Patrones</div>
          <strong style="color:#1e293b;">Mapa de calor: día de la semana × hora</strong>
        </div>
        <div class="rp-card-bd">
          <div id="heatmapContainer" class="heatmap-scroll">
            <div class="skel" style="height:210px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── SELLERS + SMALL CHARTS ─────────────────────────────────────────── %>
  <div class="row g-3 mb-3">
    <div class="col-lg-7">
      <div class="rp-card h-100">
        <div class="rp-card-hd">
          <div class="sec-lbl">Performance</div>
          <strong style="color:#1e293b;">Por mesero</strong>
        </div>
        <div class="p-0">
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Mesero</th>
                  <th class="text-end">Pedidos</th>
                  <th class="text-end">Ventas</th>
                  <th class="text-end d-none d-sm-table-cell">Prom.</th>
                </tr>
              </thead>
              <tbody id="sellersTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="row g-2">
        <div class="col-6">
          <div class="rp-card p-3" style="height:175px;">
            <div class="sec-lbl mb-1">Categoría</div>
            <div style="height:130px;position:relative;"><canvas id="categoryChart"></canvas></div>
          </div>
        </div>
        <div class="col-6">
          <div class="rp-card p-3" style="height:175px;">
            <div class="sec-lbl mb-1">Servicio</div>
            <div style="height:130px;position:relative;"><canvas id="servicioChart"></canvas></div>
          </div>
        </div>
      </div>
      <div class="row g-2 mt-0">
        <div class="col-12">
          <div class="rp-card p-3" style="height:150px;">
            <div class="sec-lbl mb-1">Método de pago</div>
            <div style="height:105px;position:relative;"><canvas id="pagoChart"></canvas></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── AI INSIGHTS ────────────────────────────────────────────────────── %>
  <div class="rp-card p-4 mb-3" id="insightsCard" style="display:none;">
    <div class="d-flex align-items-center gap-2 mb-3">
      <div class="kpi-icon" style="background:#f0fdf4;color:#16a34a;width:40px;height:40px;font-size:1.15rem;">
        <i class="bi bi-lightbulb-fill"></i>
      </div>
      <div>
        <div class="sec-lbl mb-0">Análisis automático</div>
        <strong style="color:#1e293b;">Insights inteligentes</strong>
      </div>
      <span class="badge border bg-success-subtle text-success ms-auto" id="insightsCount" style="font-size:.75rem;"></span>
    </div>
    <div class="row g-2" id="insightsList"></div>
  </div>

  <%# ── DETAIL TABLE ───────────────────────────────────────────────────── %>
  <div class="rp-card mb-4">
    <div class="rp-card-hd d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <div class="sec-lbl">Detalle</div>
        <strong style="color:#1e293b;">Pedidos del período</strong>
      </div>
      <a href="#" class="btn btn-sm btn-outline-secondary rp-csv-link" download>
        <i class="bi bi-download me-1"></i>Exportar CSV
      </a>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>N°</th><th>Cliente</th><th>Mesero</th><th>Servicio</th>
            <th>Pago</th><th class="text-end">Total</th><th>Fecha</th>
          </tr>
        </thead>
        <tbody id="detailTableBody"></tbody>
      </table>
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3">
      <small class="text-muted" id="paginationSummary"></small>
      <div class="d-flex gap-1" id="paginationControls"></div>
    </div>
  </div>

</div><%# /container-xl %>
</div><%# /rp-bg %>

<div id="reports-data" data-api-base="/api/v1/reports"></div>

<script type="module">
  import "reports_dashboard";
</script>
