<!-- ============ HERO ============ -->
<section class="landing-hero">
  <div class="landing-container landing-hero-inner">
    <% if @business.logo.attached? %>
      <%= image_tag @business.logo, class: "landing-logo" %>
    <% else %>
      <div class="landing-logo landing-logo-fallback">🍔</div>
    <% end %>

    <h1 class="landing-title"><%= @business.nombre %></h1>

    <% if @business.descripcion.present? %>
      <p class="landing-subtitle"><%= @business.descripcion %></p>
    <% end %>

    <div class="landing-cta-row">
      <%= link_to "Ver menú y pedir", public_menu_path, class: "landing-btn landing-btn-primary" %>
      <% if @business.whatsapp_negocio.present? %>
        <% wa_number = @business.whatsapp_negocio.gsub(/\D/, '') %>
        <%= link_to "WhatsApp", "https://wa.me/#{wa_number}?text=#{ERB::Util.url_encode('Hola, quiero hacer un pedido')}",
              class: "landing-btn landing-btn-ghost", target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
  </div>
</section>

<!-- ============ INFO: horario, dirección, teléfono ============ -->
<% if @business.horario.present? || @business.direccion.present? || @business.telefono.present? %>
  <section class="landing-container landing-info-grid">
    <% if @business.horario.present? %>
      <div class="landing-info-card">
        <span class="landing-info-icon">🕒</span>
        <div>
          <p class="landing-info-label">Horario</p>
          <p class="landing-info-value"><%= @business.horario %></p>
        </div>
      </div>
    <% end %>

    <% if @business.direccion.present? %>
      <div class="landing-info-card">
        <span class="landing-info-icon">📍</span>
        <div>
          <p class="landing-info-label">Dirección</p>
          <p class="landing-info-value"><%= @business.direccion %></p>
          <%= link_to "Cómo llegar →", "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(@business.direccion)}",
                class: "landing-info-link", target: "_blank", rel: "noopener" %>
        </div>
      </div>
    <% end %>

    <% if @business.telefono.present? %>
      <div class="landing-info-card">
        <span class="landing-info-icon">📞</span>
        <div>
          <p class="landing-info-label">Teléfono</p>
          <%= link_to @business.telefono, "tel:#{@business.telefono.gsub(/\D/, '')}", class: "landing-info-value landing-info-link" %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<!-- ============ MENÚ ============ -->
<% if @productos_por_categoria.any? %>
  <section class="landing-container landing-menu-section">
    <h2 class="landing-section-title">Nuestro Menú</h2>

    <% @productos_por_categoria.each do |categoria, productos| %>
      <div class="landing-menu-category">
        <h3 class="landing-menu-category-title"><%= categoria %></h3>
        <div class="landing-menu-grid">
          <% productos.each do |producto| %>
            <div class="landing-product-card">
              <% if producto.foto.attached? %>
                <%= image_tag producto.foto, class: "landing-product-photo", alt: producto.nombre %>
              <% else %>
                <div class="landing-product-photo landing-product-photo-fallback">🍔</div>
              <% end %>
              <div class="landing-product-body">
                <p class="landing-product-name"><%= producto.nombre %></p>
                <% if producto.descripcion.present? %>
                  <p class="landing-product-desc"><%= truncate(producto.descripcion, length: 90) %></p>
                <% end %>
                <p class="landing-product-price">$<%= number_with_precision(producto.precio, precision: 0, delimiter: ',') %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<!-- ============ FOOTER ============ -->
<footer class="landing-footer">
  <p>&copy; <%= Date.current.year %> <%= @business.nombre %></p>
</footer>
