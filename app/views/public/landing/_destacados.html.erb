<% if @destacados.any? %>
  <section class="landing-container landing-highlights-section" data-reveal>
    <h2 class="landing-section-title">Algunos de nuestros favoritos</h2>

    <div class="landing-highlights-grid">
      <% @destacados.each do |producto| %>
        <div class="landing-highlight-card">
          <% if producto.foto.attached? %>
            <%= image_tag producto.foto, class: "landing-highlight-photo", alt: producto.nombre %>
          <% else %>
            <div class="landing-highlight-photo landing-highlight-photo-fallback">🍟</div>
          <% end %>
          <div class="landing-highlight-body">
            <p class="landing-highlight-name"><%= producto.nombre %></p>
            <p class="landing-highlight-price">$<%= number_with_precision(producto.precio, precision: 0, delimiter: ',') %></p>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
