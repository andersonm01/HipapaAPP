<% if @business.horario.present? || @business.direccion.present? || @business.telefono.present? %>
  <div class="landing-container landing-container-wide">
    <section class="landing-info-band" aria-label="Información del local">
      <% if @business.horario.present? %>
        <div class="landing-info-item" data-reveal data-reveal-delay="0">
          <span class="landing-info-icon" aria-hidden="true">🕒</span>
          <div>
            <p class="landing-info-label">Horario</p>
            <p class="landing-info-value"><%= @business.horario %></p>
          </div>
        </div>
      <% end %>

      <% if @business.direccion.present? %>
        <div class="landing-info-item" data-reveal data-reveal-delay="90">
          <span class="landing-info-icon" aria-hidden="true">📍</span>
          <div>
            <p class="landing-info-label">Dónde estamos</p>
            <%= link_to @business.direccion, hp_maps_url(@business.direccion),
                  class: "landing-info-value landing-info-link", target: "_blank", rel: "noopener" %>
          </div>
        </div>
      <% end %>

      <% if @business.telefono.present? %>
        <div class="landing-info-item" data-reveal data-reveal-delay="180">
          <span class="landing-info-icon" aria-hidden="true">📞</span>
          <div>
            <p class="landing-info-label">Llámanos</p>
            <%= link_to @business.telefono, hp_telefono_link(@business.telefono),
                  class: "landing-info-value landing-info-link" %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
