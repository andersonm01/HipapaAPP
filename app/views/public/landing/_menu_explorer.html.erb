<% if @productos_por_categoria.any? %>
  <section class="landing-container landing-menu-section" id="menu" data-reveal>
    <h2 class="landing-section-title">Nuestro Menú</h2>
    <p class="landing-section-subtitle">Explora por categoría</p>

    <div class="landing-menu-tabs" data-menu-tabs role="tablist">
      <button type="button" class="landing-menu-tab active" data-menu-tab="all">Todos</button>
      <% @productos_por_categoria.keys.each do |categoria| %>
        <button type="button" class="landing-menu-tab" data-menu-tab="<%= categoria.parameterize %>"><%= categoria %></button>
      <% end %>
    </div>

    <div class="landing-menu-grid" data-menu-grid>
      <% @productos_por_categoria.each do |categoria, productos| %>
        <% productos.each do |producto| %>
          <div class="landing-menu-item" data-menu-category="<%= categoria.parameterize %>">
            <% if producto.foto.attached? %>
              <%= image_tag producto.foto, class: "landing-menu-item-photo", alt: producto.nombre %>
            <% else %>
              <div class="landing-menu-item-photo landing-menu-item-photo-fallback">🍟</div>
            <% end %>
            <div class="landing-menu-item-body">
              <div class="landing-menu-item-head">
                <p class="landing-menu-item-name"><%= producto.nombre %></p>
                <p class="landing-menu-item-price">$<%= number_with_precision(producto.precio, precision: 0, delimiter: ',') %></p>
              </div>
              <% if producto.descripcion.present? %>
                <p class="landing-menu-item-desc"><%= truncate(producto.descripcion, length: 80) %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="landing-menu-cta">
      <%= link_to "Ordenar ahora →", public_menu_path, class: "landing-btn landing-btn-primary" %>
    </div>
  </section>
<% end %>
