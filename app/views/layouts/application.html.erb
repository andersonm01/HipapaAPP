<!DOCTYPE html>
<html lang="es">
  <head>
    <% setting = business_setting rescue nil %>
    <title><%= setting&.nombre || 'Hi Papa' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="<%= setting&.color_secundario || '#0f172a' %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <script>
      // Applied before first paint so the sidebar doesn't flash expanded-then-collapsed
      // on hard page loads (Turbo navigations restore this class automatically since
      // <html> persists across them).
      (function() {
        try {
          if (localStorage.getItem('hipapa_sidebar_collapsed') === '1') {
            document.documentElement.classList.add('sidebar-collapsed');
          }
        } catch (e) {}
      })();
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= action_cable_meta_tag %>
    <%= javascript_importmap_tags %>
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <!-- Tema configurable como CSS variables -->
    <% if setting %>
    <style>
      :root {
        --color-brand:      <%= setting.color_primario %>;
        --color-brand-dark: <%= setting.color_secundario %>;
        --color-accent:     <%= setting.color_acento %>;
      }
    </style>
    <% end %>
  </head>

  <body class="app-body">
    <%= render "layouts/sidebar" %>

    <!-- Flash messages -->
    <% if notice.present? || alert.present? %>
      <div id="flash-container" class="fixed top-16 right-4 z-40 w-80 space-y-2">
        <% if notice.present? %>
          <div class="alert-success shadow-md">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="flex-1"><%= notice %></span>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="alert-danger shadow-md">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <span class="flex-1"><%= alert %></span>
          </div>
        <% end %>
      </div>
      <script>setTimeout(() => { const el = document.getElementById('flash-container'); if(el) el.style.opacity='0'; }, 4000);</script>
    <% end %>

    <!-- Main content -->
    <main class="px-4 py-4 lg:px-6">
      <%= yield %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <!-- QZ Tray -->
    <script src="https://cdn.jsdelivr.net/npm/qz-tray@2.2.4/qz-tray.min.js"></script>
    <script type="module">
      import "sidebar";
    </script>
  </body>
</html>
