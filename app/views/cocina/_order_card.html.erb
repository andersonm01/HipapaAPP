<%
  ks           = order.kitchen_status.presence || 'preparing'
  elapsed_min  = ((Time.current - order.created_at) / 60).floor
  status_badge = case ks
                 when 'preparing' then 'badge-dark'
                 when 'ready'     then 'badge-success'
                 else                  'badge-gray'
                 end
  status_label = case ks
                 when 'preparing' then '🔥 En prep.'
                 when 'ready'     then '✅ Lista'
                 else                  '⏳ Pendiente'
                 end
  servicio_badge = case order.tipo_servicio
                   when 'domicilio' then 'badge-info'
                   when 'llevar'    then 'badge-warning'
                   else                  'badge-gray'
                   end
%>
<div class="kitchen-card"
     data-order-id="<%= order.id %>"
     data-created-at="<%= order.created_at.iso8601 %>">

  <%# Barra de alerta de tiempo — JS la activa según urgencia %>
  <div class="kitchen-alert-bar" data-alert-bar></div>

  <%# ── Header: número, tipo, estado ── %>
  <div class="kitchen-card-header">
    <div class="flex items-center gap-2">
      <span class="kitchen-order-id">#<%= order.id %></span>
      <span class="badge <%= servicio_badge %>">
        <%= (order.tipo_servicio || 'mesa').upcase %>
      </span>
    </div>
    <span class="badge <%= status_badge %>"><%= status_label %></span>
  </div>

  <%# ── Cuerpo: cliente, tiempo, productos ── %>
  <div class="kitchen-card-body">

    <%# Cliente + timer %>
    <div class="kitchen-meta-row">
      <span class="kitchen-cliente truncate"><%= order.cliente.presence || 'Sin nombre' %></span>
      <span class="kitchen-timer" data-timer>
        <%= elapsed_min < 1 ? 'Hace menos de 1 min' : "Hace #{elapsed_min} min" %>
      </span>
    </div>

    <% if order.mesero.present? %>
      <div class="kitchen-mesero">Mesero: <%= order.mesero %></div>
    <% end %>

    <%# Hora exacta de ingreso %>
    <div class="kitchen-hora">Ingresó: <%= order.created_at.strftime("%H:%M") %></div>

    <%# Lista de productos (el cargo de domicilio no es algo para preparar) %>
    <% kitchen_items = order.order_items.reject { |i| i.product.categoria == 'Domicilio' } %>
    <% if kitchen_items.any? %>
      <ul class="kitchen-items">
        <% kitchen_items.each do |item| %>
          <li>
            <div class="kitchen-item-line">
              <span class="kitchen-item-qty"><%= item.cantidad %>×</span>
              <span class="kitchen-item-name"><%= item.product.nombre %></span>
            </div>
            <% if item.comentario.present? %>
              <div class="kitchen-item-note">📝 <%= item.comentario %></div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="kitchen-empty-items">Sin productos confirmados</p>
    <% end %>

    <%# Nota general de la orden %>
    <% if order.comentario.present? %>
      <div class="kitchen-note-general">💬 <%= order.comentario %></div>
    <% end %>
  </div>

  <%# ── Footer: botones de acción ── %>
  <div class="kitchen-card-footer">
    <%# En preparación %>
    <%= form_tag update_kitchen_status_order_path(order), method: :patch,
        data: { turbo: false }, style: "flex:1" do %>
      <input type="hidden" name="kitchen_status" value="preparing">
      <button type="submit"
        class="btn w-full <%= ks == 'preparing' ? 'btn-dark' : 'btn-secondary' %>">
        🔥 Prep.
      </button>
    <% end %>

    <%# Lista %>
    <%= form_tag update_kitchen_status_order_path(order), method: :patch,
        data: { turbo: false }, style: "flex:1" do %>
      <input type="hidden" name="kitchen_status" value="ready">
      <button type="submit"
        class="btn w-full <%= ks == 'ready' ? 'btn-success' : 'btn-secondary' %>">
        ✅ Lista
      </button>
    <% end %>

    <%# Entregada %>
    <%= form_tag update_kitchen_status_order_path(order), method: :patch,
        data: { turbo: false }, style: "flex:1" do %>
      <input type="hidden" name="kitchen_status" value="delivered">
      <button type="submit" class="btn w-full btn-secondary">
        🏁 Entregada
      </button>
    <% end %>
  </div>

</div>
