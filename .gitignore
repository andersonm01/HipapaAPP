# Bundler
.bundle/
/vendor/bundle/

# Logs
/log/*
!/log/.keep

# Temp files (NEVER commit tmp/)
/tmp/*
!/tmp/.keep

# Bootsnap cache
tmp/cache/bootsnap/

# Storage
/storage/*
!/storage/.keep

# Credentials
/config/master.key

# Node
/node_modules

# OS
.DS_Store
Thumbs.db

/app/assets/builds/*
!/app/assets/builds/.keep

# QZ Tray signing keys (never commit the private key)
/config/qztray/private_key.pem

config/qztray/private_key.pem

# Cache de tmp (bootsnap, assets, etc.)
/tmp/cache/
